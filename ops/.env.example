# ============================================================================
# Lehen — minimal bootstrap environment
# ============================================================================
# Copy to ops/.env and fill in. ops/.env is gitignored.
#
# Bring up:
#   docker compose -f ops/docker-compose.dev.yml --env-file ops/.env up --build
#
# Philosophy: this file holds ONLY what the Hub cannot start without —
# database connection, identity provider endpoint, and crypto keys.
# Everything else (LLM provider, model names, log level, retention windows,
# Keycloak audience / client ids) has stable defaults in code and is
# admin-managed via /admin/* once the Hub is running. There is no shadow
# env knob for any of those by design.

# ---- ArcadeDB ---------------------------------------------------------------
# Required.
LEHEN_ARCADEDB__PASSWORD=change-me-strong-dev-password
LEHEN_ARCADEDB__DATABASE=lehen

# ---- Keycloak ---------------------------------------------------------------
# Required.
LEHEN_KEYCLOAK__BASE_URL=http://<your-keycloak-host>:8180
LEHEN_KEYCLOAK__REALM=lehen

# ---- Crypto (REQUIRED, dev-generate each as 32 url-safe-base64 bytes) -------
# python -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
LEHEN_CRYPTO__MASTER_KEY=replace-me
LEHEN_CRYPTO__AUDIT_PEPPER=replace-me
