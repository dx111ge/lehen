{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability set required by the Lehen Edge frontend.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:webview:default",
    "shell:allow-open",
    "deep-link:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://localhost:*" },
        { "url": "http://127.0.0.1:*" },
        { "url": "https://login.microsoftonline.com/*" },
        { "url": "https://*.b2clogin.com/*" },
        { "url": "https://graph.microsoft.com/*" }
      ]
    }
  ]
}
