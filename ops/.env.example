# ============================================================================
# Lehen — local development environment
# ============================================================================
# Copy this file to ops/.env and fill in the values. ops/.env is gitignored.
#
# Bring up:
#   docker compose -f ops/docker-compose.dev.yml --env-file ops/.env up --build

# ---- ArcadeDB (graph DB, runs in Docker) ------------------------------------
# Required. Used both for the ArcadeDB root password AND for the hub's connection.
LEHEN_ARCADEDB__PASSWORD=change-me-strong-dev-password
LEHEN_ARCADEDB__DATABASE=lehen

# ---- Keycloak (identity, runs externally on the LAN) ------------------------
# Required. The 'lehen' realm is the canonical home for all Lehen users/clients.
# Set this to your Keycloak server's base URL (no trailing slash); never commit.
LEHEN_KEYCLOAK__BASE_URL=http://<your-keycloak-host>:8180
LEHEN_KEYCLOAK__REALM=lehen
# Optional overrides (defaults shown):
# LEHEN_KEYCLOAK__AUDIENCE=lehen-hub
# LEHEN_KEYCLOAK__ADMIN_ROLE=lehen-admin
# LEHEN_KEYCLOAK__EDGE_CLIENT_ID=lehen-edge
# LEHEN_KEYCLOAK__ADMIN_UI_CLIENT_ID=lehen-admin-ui
# LEHEN_KEYCLOAK__JWKS_TTL_SECONDS=600

# ---- Ollama (LLM/embeddings, runs on the Docker host) -----------------------
# host.docker.internal resolves to the Docker host from inside the hub container.
# Model selections live in DB-backed LLMConfig (admin-mutable). The vars below
# are bootstrap-only — used to seed LLMConfig on first DB initialization.
LEHEN_OLLAMA__BASE_URL=http://host.docker.internal:11434
LEHEN_ADMIN_BOOTSTRAP__INFERENCE_MODEL=gemma4:e4b
LEHEN_ADMIN_BOOTSTRAP__EMBEDDING_MODEL=nomic-embed-text

# ---- Crypto (REQUIRED) -------------------------------------------------------
# Both keys must decode from url-safe base64 to exactly 32 bytes.
# Generate each with:
#   python -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
#
# MASTER_KEY: encrypts integration secrets + per-user OAuth refresh tokens at rest (AES-256-GCM).
# AUDIT_PEPPER: keys the HMAC used for diff fingerprints in admin audit logs (A12).
# Keep these distinct and secret. Rotation = redeploy with new key + a one-shot re-encrypt script.
LEHEN_CRYPTO__MASTER_KEY=replace-me-with-32-byte-url-safe-base64
LEHEN_CRYPTO__AUDIT_PEPPER=replace-me-with-32-byte-url-safe-base64

# ---- Retention (optional; defaults shown) -----------------------------------
# Per-event-type retention windows in days. v1 writes retain_until at insert; cleanup ships in v1.x.
# LEHEN_RETENTION__LOGIN_EVENT_DAYS=90
# LEHEN_RETENTION__CONSENT_EVENT_DAYS=2557

# ---- Logging ----------------------------------------------------------------
LEHEN_LOG_LEVEL=DEBUG
